model Payment {
  id                     String        @id @default(uuid())
  requestId              String
  request                BloodRequest  @relation(fields: [requestId], references: [id], onDelete: Restrict)
  payerId                String
  payer                  User          @relation(fields: [payerId], references: [id], onDelete: Restrict)
  amount                 Float
  paymentMethod          PaymentMethod @default(BKASH)
  paymentId              String        @unique // bKash paymentID
  transactionId          String?       // bKash trxID
  status                 PaymentStatus @default(PENDING)
  paymentExecuteResponse Json?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([status, paymentId])
  @@map("payments")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([action, resource])
  @@index([createdAt])
  @@map("audit_logs")
}
