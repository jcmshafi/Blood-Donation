{
	"info": {
		"_postman_id": "b1a2c3d4-e5f6-47a8-9b0c-1d2e3f4a5b6c",
		"name": "Phase 1 - Auth & Role-Based Access Control (RBAC)",
		"description": "Blood Donation & Emergency Platform Backend API - Phase 1 Endpoints.\nIncludes: Register (Donor/Recipient), Login, GCP Google Social Login, Refresh Token, Logout.\nAuth tokens are automatically extracted and saved to {{accessToken}} for subsequent requests.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "0. Health Check & Welcome",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/",
					"host": ["{{baseUrl}}"],
					"path": [""]
				}
			},
			"response": []
		},
		{
			"name": "1. Register as DONOR",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"var res = pm.response.json();",
							"pm.test(\"Response has success format\", function () {",
							"    pm.expect(res.success).to.eql(true);",
							"});",
							"if (res.data && res.data.accessToken) {",
							"    pm.collectionVariables.set(\"accessToken\", res.data.accessToken);",
							"    pm.collectionVariables.set(\"refreshToken\", res.data.refreshToken);",
							"    pm.collectionVariables.set(\"donorUserId\", res.data.user.id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Tanvir Hasan (Donor)\",\n  \"email\": \"tanvir.donor@example.com\",\n  \"password\": \"Password@123\",\n  \"role\": \"DONOR\",\n  \"phone\": \"+8801712345678\",\n  \"address\": \"Mirpur 10, Dhaka\",\n  \"bloodGroup\": \"O_POSITIVE\",\n  \"latitude\": 23.8071,\n  \"longitude\": 90.3686\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/register",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "auth", "register"]
				}
			},
			"response": []
		},
		{
			"name": "2. Register as RECIPIENT",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"var res = pm.response.json();",
							"pm.test(\"Response has success format\", function () {",
							"    pm.expect(res.success).to.eql(true);",
							"});",
							"if (res.data && res.data.accessToken) {",
							"    pm.collectionVariables.set(\"recipientAccessToken\", res.data.accessToken);",
							"    pm.collectionVariables.set(\"recipientUserId\", res.data.user.id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
